{
  "name": "Software II - Ambiente de Desarrollo",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ritwickdey.LiveServer",
        "formulahendry.auto-rename-tag",
        "eamodio.gitlens",
        "usernamehw.errorlens"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.tabSize": 2
      }
    }
  },

  "forwardPorts": [3000, 5500],
  "portsAttributes": {
    "3000": { "label": "Servidor Express", "onAutoForward": "notify" },
    "5500": { "label": "Live Server (HTML/CSS)", "onAutoForward": "notify" }
  },

  "postCreateCommand": "echo 'Codespace listo. Entrá a la carpeta del TP y corré: npm install'"
}
